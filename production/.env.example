# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- 3DCityDB PostgreSQL connection ---
CITYDB_HOST=localhost
CITYDB_PORT=5432
CITYDB_NAME=citydb
CITYDB_USER=postgres
CITYDB_PASSWORD=your_password_here
CITYDB_SCHEMA=citydb

# --- Query behaviour ---
# Number of distinct values below which a generic attribute is treated as categorical
CATEGORICAL_THRESHOLD=20
# How many sample values to show for non-categorical attributes
SAMPLE_VALUES_COUNT=5

# --- LLM provider -- set exactly one ------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Point the "openai" provider at a local OpenAI-compatible server (vLLM, llama.cpp,
# LM Studio, ...) instead of api.openai.com. OPENAI_API_KEY can be a dummy value
# if the server doesn't check it. Type the server's model name into the Model
# field in the UI (it doesn't need to be a real OpenAI model).
# OPENAI_BASE_URL=http://host.docker.internal:8000/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 3D viewer: default terrain & base map (only used when ENABLE_VIZ=true) ---
# Both default to Germany-wide, freely licensed sources (basemap.de) and are
# applied unconditionally. Leave a *_URL empty to disable that layer; override all of these for another
# country's terrain/WMS.
#
# Terrain: a Cesium quantized-mesh endpoint (has its own layer.json).
VIEWER_TERRAIN_URL=https://web3d.basemap.de/cesium/dgm5-mesh/
VIEWER_TERRAIN_NAME=DGM5 (basemap.de)
VIEWER_TERRAIN_TOOLTIP=basemap.de - DGM5 (Germany)
#
# Base map: an OGC WMS layer, added as a selectable BaseLayerPicker entry.
VIEWER_WMS_URL=https://sgx.geodatenzentrum.de/wms_basemapde?
VIEWER_WMS_LAYER=de_basemapde_web_raster_farbe
VIEWER_WMS_NAME=WMS basemap.de
VIEWER_WMS_TOOLTIP=(C) basemap.de
# basemap.de's WMS sends Access-Control-Allow-Origin: *, so no proxy is needed
# by default; this image does not ship the vendored client's own /proxy/
# endpoint. Only set this if you point VIEWER_WMS_URL at a WMS without CORS.
# VIEWER_WMS_PROXY_URL=/proxy/
