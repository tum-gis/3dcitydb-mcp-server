# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- 3DCityDB connection (BYOD variant) ----------------------------------------
# For docker-compose.byod.yml: point at your existing 3DCityDB instance.
# For docker-compose.fullstack.yml: leave these blank; use POSTGRES_* below.

# --- 3DCityDB PostgreSQL connection ---
# CITYDB_HOST=your_DB_host_computer_here
# CITYDB_PORT=5432
# CITYDB_NAME=citydb
# CITYDB_USER=your_username_here
# CITYDB_PASSWORD=your_password_here
# CITYDB_SCHEMA=citydb

# --- PostgreSQL (fullstack variant only) ---------------------------------------
# For docker-compose.byod.yml: leave these blank; use CITYDB_* above.
POSTGRES_DB=citydb
POSTGRES_USER=citydb
POSTGRES_PASSWORD=citydb
# Enter the same SRID that is used in your CityGML dataset (e.g. EPSG:25832)
SRID=25832
POSTGIS_SFCGAL=true


# --- MCP Server query behaviour ---
# Number of distinct values below which a generic attribute is treated as categorical
CATEGORICAL_THRESHOLD=20
# How many sample values to show for non-categorical attributes
SAMPLE_VALUES_COUNT=5


# --- LLM provider for the agentic chatbot -- set exactly one ------------------------------------------
# Set this key, if you are using a LLM from Anthropic 
# ANTHROPIC_API_KEY=sk-ant-...

# Set this key, if you are using a LLM from OpenAI
# OPENAI_API_KEY=sk-...

# You can use other providers, if they offer an OpenAI compatible API.
# In this case set the base URL of that external service.
# OPENAI_BASE_URL=https://...
# OPENAI_API_KEY can then be a dummy value if the server doesn't check it.
#
# You can also point the OpenAI base URL to a locally running OpenAI-compatible 
# server (vLLM, llama.cpp, LM Studio, ...) instead of api.openai.com. 
# OPENAI_BASE_URL=http://some_machine_on_your_network:port/v1
# Type the server's model name into the Model field in the UI 
# (it doesn't need to be a real OpenAI model) 

# Set this URL, if you are using Ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# When using Ollama you can alternatively connect via Ollama's 
# OpenAI compatible endpoint. Set the base URL to the OpenAI 
# endpoint of the Ollama server:
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# You should then also set OPENAI_API_KEY to "ollama":
# OPENAI_API_KEY=ollama
# This signals the chatbot to fetch the available list of LLMs via
# the Ollama API. 

# Cloud / OpenAI-kompatible Provider (Standard: 120 s)
LITELLM_TIMEOUT=600

# Ollama / lokale Modelle (Standard: 300 s)
LITELLM_TIMEOUT_LOCAL=600

# --- Agent settings -----------------------------------------------------------
AGENT_MAX_ITERATIONS=10

# --- 3D viewer: default terrain & base map (only used when ENABLE_VIZ=true) ---
# Both default to Germany-wide, freely licensed sources (basemap.de) and are
# applied unconditionally. Leave a *_URL empty to disable that layer; override all of 
# these for another country's terrain/WMS.
#
# Terrain: a Cesium quantized-mesh endpoint (has its own layer.json).
VIEWER_TERRAIN_URL=https://sgx.geodatenzentrum.de/gdz_basemapde_3d_gelaende/dgm5_4326_mesh/
VIEWER_TERRAIN_NAME=DGM5 (basemap.de)
VIEWER_TERRAIN_TOOLTIP=basemap.de - DGM5 (Germany, via Geodatenzentrum)
#
# Base map: an OGC WMS layer, added as a selectable BaseLayerPicker entry.
VIEWER_WMS_URL=https://sgx.geodatenzentrum.de/wms_basemapde?
VIEWER_WMS_LAYER=de_basemapde_web_raster_farbe
VIEWER_WMS_NAME=WMS basemap.de
VIEWER_WMS_TOOLTIP=(C) basemap.de
# basemap.de's WMS sends Access-Control-Allow-Origin: *, so no proxy is needed
# by default; this image does not ship the vendored client's own /proxy/
# endpoint. Only set this if you point VIEWER_WMS_URL at a WMS without CORS.
# VIEWER_WMS_PROXY_URL=/proxy/

# ── Flood scene (3D viewer, optional) ─────────────────────────────────────────
# Adds a short, dataset-independent hint to the prompt: a query result with a
# `flood_level_m` column draws water at that height and colours every building
# (red = flooded, green = protected by `protection_m`). See docs/flood-scene.md.
# FLOOD_SCENE=true
# Function codes that are not buildings (here ALKIS: bridges, walls, canopies).
# Excluded from the viewer's counter and named in the prompt hint.
# FLOOD_EXCLUDE_FUNCTIONS=51007_1500,51009_1610,51009_1700,53001_1800
# Viewer only (gauge widget marks, not added to the prompt): gauge zero in the
# data's height system, warning levels and a historic flood, readings in cm.
# FLOOD_GAUGE_NAME=Passau/Donau
# FLOOD_GAUGE_ZERO_M=286.439
# FLOOD_STAGES=700,740,770,850
# FLOOD_REFERENCE_CM=1289
# FLOOD_REFERENCE_LABEL=Juni 2013

# ── Sessions / multiple users (see docs/session-layer.md) ─────────────────────
# How many chat turns may run at the same time (Gradio's default would be 1).
# WEBUI_CONCURRENCY=4
# Per-user data folder (inside the agent container; ./data is mounted at /app/data).
# CITYDB_USER_DATA_DIR=/app/data/users
# Days of inactivity before a user's data is deleted. 0 disables.
# CITYDB_USER_EXPIRY_DAYS=14

# ── Spatial scratchpad (see docs/scratchpad.md) ───────────────────────────────
# Per-user saved results (building sets, pins, hulls) shown in the 3D viewer.
# Creates the table citydb.scratchpad, the view my_scratchpad and a read-only
# role (citydb_query, override with CITYDB_QUERY_USER / CITYDB_QUERY_PASSWORD)
# that run_query then uses.
# CITYDB_SCRATCHPAD=true
# Shared scratchpad user id for MCP clients without a web UI session (e.g. Claude Desktop);
# default is a fixed uuid.
# CITYDB_SCRATCHPAD_MCP_USER=
# Audit log of scratchpad changes: one JSON line per change (save, update, show, hide,
# delete, purge). Empty switches it off; default is this path when /app/data exists.
# CITYDB_MCP_AUDIT_LOG=/app/data/audit/scratchpad.jsonl
